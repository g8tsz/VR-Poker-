{
  "name": "vr-poker",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "clients/*"
  ],
  "scripts": {
    "test": "npm test -w @vr-poker/core -w @vr-poker/deal -w @vr-poker/ledger -w @vr-poker/tournament",
