# Local / compose defaults — copy to infra/.env and adjust
# CHANGE default passwords and AUTH_DEV_SECRET before any shared deployment.

POSTGRES_USER=vrpoker
POSTGRES_PASSWORD=vrpoker
POSTGRES_DB=vrpoker
DATABASE_URL=postgres://vrpoker:vrpoker@localhost:5432/vrpoker

# Services
PORT=8787
LEDGER_PORT=8786
DEAL_PORT=8788
TOURNAMENT_PORT=8789
COSMETICS_PORT=8790
DEAL_HISTORY=./data/hand-history.jsonl

# Game-server → microservices (set in docker-compose; omit for local npm run dev)
# LEDGER_URL=http://localhost:8786
# DEAL_RNG_URL=http://localhost:8788

# CORS (default * for local dev; set to your web/Quest origin in production)
# CORS_ORIGIN=http://localhost:3080

# Service-to-service JWT when AUTH_DISABLED=0 (mint with infra/scripts/dev-token.mjs)
# SERVICE_AUTH_TOKEN=

# Auth (managed provider — do not build custom auth)
AUTH_DISABLED=1
AUTH_DEV_SECRET=vr-poker-dev-secret-change-me
AUTH_ISSUER=vr-poker-local
AUTH_AUDIENCE=vr-poker-api
# AUTH_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
